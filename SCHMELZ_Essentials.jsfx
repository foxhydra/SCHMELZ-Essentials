// Back to base rate: the inner-rate samples y0..y3 go through the halfband stages, one base sample out.
function OS2_down(y0, y1, y2, y3) local(k, v, e, o, z0, z1)
(
  (os_f === 1) ? y0 : (
  (os_f === 2) ? ( z0 = y0; z1 = y1; ) : (
    // stage 2 (4x -> 2x): out = (A0(even) + A1(previous odd)) / 2
    k = 0;
    loop(2,
      e = (k === 0) ? y0 : y2; o = (k === 0) ? this.dq : y1;
      v = 0.5 * (this.wa1.OS_ap(this.wa0.OS_ap(e, OS_H2_0), OS_H2_2) + this.wb0.OS_ap(o, OS_H2_1));
