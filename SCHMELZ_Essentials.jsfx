// The Low Cut corner glides logarithmically to its target; redesign on request and at the end.
function HPF_glide(k, redesign)
(
  this.fc = exp(log(this.ft) + k * (log(this.fc) - log(this.ft)));
  (abs(this.fc / this.ft - 1.0) < 0.0005) ? ( this.fc = this.ft; redesign = 1; );
  redesign ? this.HPF_design();
