);

xt_bleed_L = xt_L.XT_process(xR);
xt_bleed_R = xt_R.XT_process(xL);
xL += xt_bleed_L;
xR += xt_bleed_R;

// output coupling caps (DC block + LF phase turn), both 5.0 Hz
xL = out_hp_L.BQ_tick(xL);
xR = out_hp_R.BQ_tick(xR);

// Mono Maker sits after Iron / Crosstalk / coupling HP and before Drive / Weight / Clipper.
// After the clipper it pushed the peaks over the ceiling (L/R are clipped separately and
