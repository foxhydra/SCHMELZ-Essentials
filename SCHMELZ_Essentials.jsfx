      cr_p11 *= crh_mk; cr_p12 *= crh_mk; cr_p22 *= crh_mk;   // the Hardware's net gain incl. its make-up
      // The fade source is M.x + cr_hwq.(H - M.x), where H is the Hardware branch, running
