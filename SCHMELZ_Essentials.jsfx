function OS_setFactor()
(
  os_f  = (srate <= 50000) ? 4 : (srate <= 100000) ? 2 : 1;
  os_d  = (os_f === 4) ? 5 : (os_f === 2) ? 4 : 0;
  clf_d = (os_f === 4) ? CLF_DLY : (os_f === 2) ? 23 : 0;
