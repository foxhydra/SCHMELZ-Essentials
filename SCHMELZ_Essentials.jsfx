( y1 = a * (x - y1) + x1; x1 = x; y1 + 0.0; );   // returns a computed value, not a static local (OS2_down adds two calls in one sum)
function OS_apclr() instance(x1, y1) ( x1 = y1 = 0.0; );
function OS2_setSampleRate()
(
  0;   // the halfband coefficients are constants (sample-rate independent fractions)
);

// Clear the oversampler's allpass states.
function OS2_reset()
(
  this.ua0.OS_apclr(); this.ua1.OS_apclr(); this.ua2.OS_apclr(); this.ua3.OS_apclr();
  this.ub0.OS_apclr(); this.ub1.OS_apclr(); this.ub2.OS_apclr(); this.ub3.OS_apclr();
  this.va0.OS_apclr(); this.va1.OS_apclr(); this.vb0.OS_apclr();
  this.wa0.OS_apclr(); this.wa1.OS_apclr(); this.wb0.OS_apclr();
  this.da0.OS_apclr(); this.da1.OS_apclr(); this.da2.OS_apclr(); this.da3.OS_apclr();
  this.db0.OS_apclr(); this.db1.OS_apclr(); this.db2.OS_apclr(); this.db3.OS_apclr();
  this.dq = 0.0; this.dz = 0.0;
  this.os_y0 = 0.0;
  this.os_y1 = 0.0;
  this.os_y2 = 0.0;
  this.os_y3 = 0.0;
  this.th_s = 0.0;
);

// --- Oversampling by sample rate ---------------------------
// A fixed factor at every rate (4x at 96 kHz = 384 kHz inner) buys nothing. The curves
// need an inner rate around 176..192 kHz; more changes nothing in the band (measured).
// So 4x up to 50 kHz, 2x up to 100 kHz, 1x above. The inner rate is 176.4 or 192 kHz
// at every rate, so curves and aliasing are the same at 44.1 and 88.2 (and 48/96/192).
// Applies to Grit, Tone and the clipper. Fixed per session, set in @init and in the
// srate branch.
// Delays (base samples): OS2 5 / 4 / 0, clipper 27 / 23 / 0.
// The polyphase halfbands need 3.5673 base samples (2x) / 4.6368 (4x). Thiran allpasses
// at the 2x rate complete that to 4.000 / 5.000 (d = 0.86539 / 0.72649 2x samples),
// because os_d, the FIFOs and PDC are integers.
OS_TH_2 = 0.072161668886411;   // (1 - 0.865390) / (1 + 0.865390)
OS_TH_4 = 0.158422616638574;   // (1 - 0.726486) / (1 + 0.726486)
