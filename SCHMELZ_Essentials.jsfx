S = (xL - xR) * 0.5;
left.si.side_shelf.BQ_rampTick(); left.si.big_shelf.BQ_rampTick();
S = left.si.side_shelf.BQ_tick(S);   // Depth: below the corner
S = left.si.big_shelf.BQ_tick(S);    // High Width: above the corner
si_xt = si_in ? 1.0 : 0.0;
(si_xm !== si_xt || si_x1 !== si_xt) ? (
  si_x1 = si_xt + xf_k * (si_x1 - si_xt);
  si_xm = si_x1 + xf_k * (si_xm - si_x1);
