        : (crh_dmq === 2) ? ( cr_n11 = 0.5 * (crh_gA + crh_gB); cr_n12 = 0.5 * (crh_gA - crh_gB); cr_n22 = cr_n11; )
        : ( cr_n11 = crh_gA; cr_n12 = 0.0; cr_n22 = crh_gB; );
        cr_m11 += cr_hwq * (crh_mk * cr_n11 - cr_m11); cr_m12 += cr_hwq * (crh_mk * cr_n12 - cr_m12); cr_m22 += cr_hwq * (crh_mk * cr_n22 - cr_m22);
        cr_hwq = 0.0;
      );
      // the Hardware branches start at the gain that played
      CRH_reset((cr_dm === 1) ? cr_g : cr_gA, (cr_dm === 1) ? cr_g : cr_gB, cur_cth + CRH_TOFF);
      cr_pm = cr_dm;
