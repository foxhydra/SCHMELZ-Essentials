// continuous params are set as targets; @sample glides cur_* toward them
input_trim_k  = DB_TO_K(slider1);
hpf_freq      = slider3;
hpf_last_on   = 1;
hpf_mode      = (slider2 >= 0.5) ? hpf_last_on : 0;
((slider4 | 0) !== lc_sel) ? ( lc_sel = slider4 | 0; lc_fade = 1; );
hc_on_t = (slider5 >= 0.5) ? 1 : 0;
hc_ft   = max(1000.0, min(30000.0, slider6));
((slider7 | 0) !== hc_sel) ? ( hc_sel = slider7 | 0; hc_fade = 1; hc_clr = 1; );

vd_in         = (slider8 >= 0.5) ? 1 : 0;
// Grit: amount in percent (0 = bit-exact off); onset = the level above which the share stays constant
vd_drive_norm   = max(0.0, min(1.0, slider9 / 100.0));
vd_density_norm = DB_TO_K(slider10);

ve_in         = (slider11 >= 0.5) ? 1 : 0;
ve_low_idx    = slider12  | 0;
ve_low_gain   = slider13;
// bass boost dip: position x 0.25..1, Q / (width/100), depth x 1..2
ve_dp_pos     = max(slider14, 1.0) / 100.0;
ve_dp_q       = 100.0 / max(slider15, 1.0);
ve_dp_dep     = slider16 / 100.0;
ve_hi_idx     = slider17  | 0;
ve_hi_gain    = slider18;

// Crush: crush_in = 0 off, 1 linked, 2 M/S, 3 L/R
cr_last       = (slider20 | 0) + 1;
crush_in      = (slider19 >= 0.5) ? cr_last : 0;
crush_th_dB   = floor((10.0 - 0.4 * slider21) * 10.0 + 0.5) / 10.0;   // 0..100 % (right = more compression) = +10..-30 dB
crush_wet     = slider23 / 100.0;
crush_drive   = max(0.0, min(12.0, slider22));   // the input stage
crush_out_k   = DB_TO_K(slider24);

si_in         = (slider25 >= 0.5) ? 1 : 0;
si_space_dB   = slider26;
si_shuffle_hz = slider27;
si_width_dB   = slider28;
si_big_dB     = slider29;
si_width_k_tgt = DB_TO_K(si_width_dB);

tx_in         = (slider30 >= 0.5) ? 1 : 0;
// Iron Drive sets the knee, Character blends from the measured curve (odd) into warmth (H2)
tx_drive_tgt  = TX_DRIVE_MIN + (TX_DRIVE_MAX - TX_DRIVE_MIN) * (slider31 / 10.0);
tx_bias_tgt   = slider32 / 100.0;
// Drive sits before Weight and the clipper and sets how hard it is driven. Output is the last stage.
drive_k     = DB_TO_K(slider35);
out_final_k = DB_TO_K(slider43);
mono_mode   = slider34 | 0;

clip_ceil_dB    = slider39;
clip_ceil_lin   = DB_TO_K(clip_ceil_dB);
clip_in         = (slider36 >= 0.5) ? 1 : 0;
clip_depth_tgt  = slider40;
clip_blend_tgt  = slider41 / 100.0;
wm_t = (slider38 >= 0.5) ? 1.0 : 0.0;   // Weight Mode
// Clip Sub Cut: off keeps the last corner (for fading out)
csb_on = (slider42 >= 10.0) ? 1.0 : 0.0;
(csb_on > 0.0) ? csb_ft = CSB_freq(slider42);
weight_tgt      = slider37 / 100.0;
// Channel matching scales all tolerances. It is not smoothed, since it is a voicing
// setting and not a performance control. The filter states stay put; only the
// coefficients change.
SPREAD_apply(slider33);

(!sm_init) ? (
  in_k_s    = input_trim_k;  in_k_s1 = input_trim_k;
  hpf_mix   = (hpf_mode > 0) ? 1.0 : 0.0;
  lc_sel = slider4 | 0; LC_setWeights(); lc_fade = 0;
  hpf_m1    = hpf_mix;
  // High Cut starts on the switches
  hc_mix = hc_m1 = hc_on_t ? 1.0 : 0.0;
  hc_sel = slider7 | 0; hc_fade = 0; hc_clr = 0;
  memset(HC_IB + 460, 0.0, 20); HC_IB[460 + hc_sel] = 1.0; HC_IB[470 + hc_sel] = 1.0;
  hc_fc = hc_ft; HC_design(hc_fc);
  drv_s     = drive_k;       drv_s1  = drive_k;
  outf_s    = out_final_k;   outf_s1 = out_final_k;
  crout_s   = crush_out_k;   crout_s1 = crush_out_k;
  cur_vd_dn = vd_drive_norm;
  cur_vd_dd = vd_density_norm;
  cur_ve_lg = ve_low_gain;
  cur_ve_li = ve_low_idx;
  cur_ve_hi = ve_hi_idx;
  cur_ve_hg = ve_hi_gain;
  cur_dp_pos = ve_dp_pos; cur_dp_q = ve_dp_q; cur_dp_dep = ve_dp_dep;
  cur_cth   = crush_th_dB;
  cur_crd   = crush_drive; crh_gi = 10 ^ (cur_crd / 20.0); crh_go = 1.0 / crh_gi; crh_mkT = cur_cth; crh_mkD = cur_crd; crh_mk = CRH_mk(cur_cth - cur_crd);
  cwet_s    = crush_wet; cwet_s1 = crush_wet;
  cur_sp    = si_space_dB;
  cur_shuf  = si_shuffle_hz;
  cur_big   = si_big_dB;
  cur_wd_k  = si_width_k_tgt; cur_wd_k1 = si_width_k_tgt;
  cur_ceil  = clip_ceil_lin; cur_ceil1 = clip_ceil_lin;
  cur_cd    = clip_depth_tgt;
  CL_setDepth(cur_cd);
  cur_cb    = clip_blend_tgt; cur_cb1 = clip_blend_tgt;
  cur_wt    = weight_tgt; cur_wt1 = weight_tgt;
  wt_L.WT_setAmount(cur_wt); wt_R.WT_setAmount(cur_wt);
  cur_tx_dr = tx_drive_tgt;
  cur_tx_bi = tx_bias_tgt;
  sm_init = 1;
  sm_tick = 0;
);

pdc_delay   = os_d + os_d + os_d + clf_d;   // Grit, Tone, Crush OS FIFOs + clipper
pdc_bot_ch  = 0;
pdc_top_ch  = 2;

// The Tone and Field shelves are left to their own glide / ramp while it runs (it
// redesigns at every step and at the end, with the current tolerance). A direct redesign
// here cancelled the ramps and stepped them on every SLIDER_update during a glide. The
// rest (Low Cut target, Grit, Iron, tolerance) is set here.
ch_skve = ((abs(cur_ve_lg - ve_low_gain) > 0.005 || abs(cur_ve_hg - ve_hi_gain) > 0.005
            || cur_ve_li !== ve_low_idx || cur_ve_hi !== ve_hi_idx
            || cur_dp_pos !== ve_dp_pos || cur_dp_q !== ve_dp_q || cur_dp_dep !== ve_dp_dep)
           || left.ve.lo.rn > 0 || left.ve.hi.rn > 0 || left.ve.lb.rn > 0 || left.ve.ld.rn > 0) ? 1 : 0;
ch_sksi = ((abs(cur_sp - si_space_dB) > 0.005 || abs(cur_shuf - si_shuffle_hz) > 0.5 || abs(cur_big - si_big_dB) > 0.005)
           || left.si.side_shelf.rn > 0 || left.si.big_shelf.rn > 0) ? 1 : 0;
left.CH_setSampleRate(hpf_mode, hpf_last_on, cur_ve_li, cur_ve_lg, cur_ve_hi, cur_ve_hg,
                       cur_shuf, cur_sp, TOLF_L);
right.CH_setSampleRate(hpf_mode, hpf_last_on, cur_ve_li, cur_ve_lg, cur_ve_hi, cur_ve_hg,
                       cur_shuf, cur_sp, TOLF_R);
out_hp_L.BQ_hp1(5.0, srate);
out_hp_R.BQ_hp1(5.0, srate);

!ch_sksi ? left.si.SI_setBigness(cur_shuf, cur_big);
ch_skve = ch_sksi = 0;   // @init and the rate branch design everything
// redesign only on change, then it glides (40 ms, mm_gk)
(mono_mode !== mm_prev) ? (
  mm.MM_setSampleRate(mono_mode, 1);
  mm_prev = mono_mode;
);

xt_L.XT_setSampleRate();
xt_R.XT_setSampleRate();

last_srate = srate;

meter_decay_k = exp(-1.0 / (0.300 * srate));
co_k          = exp(-1.0 / (CO_T * srate));   // correlation meter
led_decay_k   = exp(-1.0 / (0.150 * srate));
smooth_k      = exp(-1.0 / (0.015 * srate));
hpf_mk      = exp(-1.0 / (0.006 * srate));   // Low Cut / High Cut crossfade, two stages
xf_k        = exp(-1.0 / (0.006 * srate));   // module crossfade

left.vd.VD_setDrive(cur_vd_dn, cur_vd_dd, VD_BTOL_L);
right.vd.VD_setDrive(cur_vd_dn, cur_vd_dd, VD_BTOL_R);
left.tx.TX_setDrive(cur_tx_dr, cur_tx_bi, TX_BTOL_L);
right.tx.TX_setDrive(cur_tx_dr, cur_tx_bi, TX_BTOL_R);
// Weight follows a Spread change (its channel tolerance)
wt_L.WT_setAmount(cur_wt); wt_R.WT_setAmount(cur_wt);

prev_slider2 = slider2; prev_slider3 = slider3; prev_slider4 = slider4;
prev_slider5 = slider5; prev_slider6 = slider6; prev_slider7 = slider7;
prev_slider8 = slider8; prev_slider9 = slider9; prev_slider10 = slider10;
prev_slider11 = slider11; prev_slider13 = slider13; prev_slider14 = slider14; prev_slider15 = slider15;
prev_slider16 = slider16; prev_slider18 = slider18;
prev_slider19 = slider19; prev_slider20 = slider20; prev_slider21 = slider21; prev_slider23 = slider23;
prev_slider24 = slider24; prev_slider22 = slider22;
prev_slider25 = slider25; prev_slider26 = slider26; prev_slider27 = slider27; prev_slider28 = slider28;
prev_slider29 = slider29;
prev_slider30 = slider30; prev_slider31 = slider31; prev_slider32 = slider32;
prev_slider35 = slider35; prev_slider36 = slider36; prev_slider37 = slider37; prev_slider38 = slider38;
prev_slider39 = slider39; prev_slider40 = slider40; prev_slider41 = slider41; prev_slider42 = slider42;
);

@slider
SLIDER_update();

@block
gfx_dirty ? ( gfx_dirty = 0; SLIDER_update(); );
// Display at the audible position. REAPER computes ahead (anticipative FX, up to 200 ms),
// so @block runs ahead of what is heard. Every block stores a snapshot stamped with the
// stream time of its first sample (ring AN_SB, 256 x AN_SN). @gfx picks the one whose
// stream time the clock has reached since playback start. The stream time has no jumps
// (loop, seek, play rate).
(play_state & 1) ? (
  !an_play ? ( an_play = 1; an_t0 = time_precise(); an_st = 0.0; );
) : an_play = 0;
an_b = AN_SB + an_wi * AN_SN;
an_b[0] = an_st; an_st += samplesblock / srate;
an_b[247] = out_peak_L; an_b[248] = out_peak_R; an_b[249] = hfc_gr_db; an_b[250] = mod_act_cl;
// Correlation; -9 = no signal (below -90 dBFS RMS). With one channel only, r = 0. A
// channel more than 40 dB below the other counts as silent (a left-only signal read +0.72
// through the crosstalk).
co_now = (co_ll + co_rr > 0.000000002) ?
  ((min(co_ll, co_rr) < 0.0001 * max(co_ll, co_rr)) ? 0.0 : max(-1.0, min(1.0, co_lr / sqrt(co_ll * co_rr)))) : -9.0;
an_b[252] = co_now;
an_wi = (an_wi + 1) & 255; an_cnt = min(an_cnt + 1, 256);

@sample

(srate != last_srate) ? (
  OS_setFactor();
  // Compensation of the FIR edge at 44.1 kHz: RBJ bell at the 2x rate.
  clf_eq = (srate > 43000 && srate < 46000) ? 1 : 0;
  ceq_A = 10 ^ (1.254 / 40.0); ceq_w = 2.0 * $pi * 20014.7 / (2.0 * srate); ceq_al = sin(ceq_w) / (2.0 * 16.1768);
  ceq_n = 1.0 / (1.0 + ceq_al / ceq_A);
  ceq_b0 = (1.0 + ceq_al * ceq_A) * ceq_n; ceq_b1 = -2.0 * cos(ceq_w) * ceq_n; ceq_b2 = (1.0 - ceq_al * ceq_A) * ceq_n;
  ceq_a1 = ceq_b1; ceq_a2 = (1.0 - ceq_al / ceq_A) * ceq_n;
  left.ve.VE_reset(); right.ve.VE_reset();
  // also clear Grit's oversampler and let it warm up again, otherwise it keeps running
  // with the state of the old factor
  left.vd.os.OS2_reset();  left.vd.os_cold = 1;
  right.vd.os.OS2_reset(); right.vd.os_cold = 1;
  left.CH_setSampleRate(hpf_mode, hpf_last_on, cur_ve_li, cur_ve_lg, cur_ve_hi, cur_ve_hg,
                         cur_shuf, cur_sp, TOLF_L);
  right.CH_setSampleRate(hpf_mode, hpf_last_on, cur_ve_li, cur_ve_lg, cur_ve_hi, cur_ve_hg,
                         cur_shuf, cur_sp, TOLF_R);
  CR_setSampleRate(); CRH_setSampleRate(); crhA.os.OS2_setSampleRate(); crhB.os.OS2_setSampleRate();
  out_hp_L.BQ_hp1(5.0, srate);
  out_hp_R.BQ_hp1(5.0, srate);
  xt_L.XT_setSampleRate();
  xt_R.XT_setSampleRate();
  meter_decay_k = exp(-1.0 / (0.300 * srate));
  co_k          = exp(-1.0 / (CO_T * srate));
  led_decay_k   = exp(-1.0 / (0.150 * srate));
  smooth_k      = exp(-1.0 / (0.015 * srate));
  hpf_mk      = exp(-1.0 / (0.006 * srate));   // Low Cut crossfade, two stages
