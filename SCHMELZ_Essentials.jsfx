      cr_yb = crhB.CRH_br(cr_b, crh_gB, (crh_grB === 0.0) ? 1 : 0);
      (crh_dm === 1) ? (
        cr_p = max(crhA.CRH_det(), crhB.CRH_det());
        crh_eA += ((cr_p > crh_eA) ? crh_ka : crh_kr) * (cr_p - crh_eA);
        crh_grA = CRH_law(crh_eA, crh_T); crh_gA = (crh_grA === 0.0) ? 1.0 : 10 ^ (crh_grA / 20.0); crh_grB = crh_grA; crh_gB = crh_gA; crh_eB = crh_eA;
      ) : (
        cr_p = crhA.CRH_det(); crh_eA += ((cr_p > crh_eA) ? crh_ka : crh_kr) * (cr_p - crh_eA);
        cr_p = crhB.CRH_det(); crh_eB += ((cr_p > crh_eB) ? crh_ka : crh_kr) * (cr_p - crh_eB);
        crh_grA = CRH_law(crh_eA, crh_T); crh_gA = (crh_grA === 0.0) ? 1.0 : 10 ^ (crh_grA / 20.0);
        crh_grB = CRH_law(crh_eB, crh_T); crh_gB = (crh_grB === 0.0) ? 1.0 : 10 ^ (crh_grB / 20.0);
