      crh_T = cur_cth + CRH_TOFF;
      (crh_dm === 2) ? ( cr_a = 0.5 * (cr_iL + cr_iR); cr_b = 0.5 * (cr_iL - cr_iR); ) : ( cr_a = cr_iL; cr_b = cr_iR; );
