);


// --- High Cut ---------------------------------------------------------------
// Positions as on the Low Cut, range 1..30 kHz. Analog mirrors the Low Cut Analog (3rd
// order, Q 1.2, +0.5 dB at label/1.67, label at -3 dB even after bilinear warping).
// 12/24/48/96 dB/oct are Butterworth 2nd/4th/8th/16th order (RBJ cascades, -3 dB at the
// label). Minimum phase, at most 0.45 x rate.
// The filter sections live in a table in memory (HC_IB) and run in loops, because EEL2
// inlines every function at every call site.
HCF_FCORR = 1.10608;
HC_IB = 1040384;          // coefficients (25 x 5) from 0, states from 200/260, tables from 400,
                          // coefficient ramp: old set 800 / steps 925 / target 1050 (125 each);
                          // the rest of the region is free
function HC_tables() local(s)
( // Qs: Analog LP1 + LP2 Q 1.2, BW2, BW4 (2), BW8 (4), BW16 (8)
  HC_IB[400] = 0.0;        HC_IB[401] = 1.2;        HC_IB[402] = 0.70710678;
  HC_IB[403] = 0.54119610; HC_IB[404] = 1.30656296;
  HC_IB[405] = 0.50979558; HC_IB[406] = 0.60134489; HC_IB[407] = 0.89997622; HC_IB[408] = 2.56291545;
  HC_IB[409] = 0.50241929; HC_IB[410] = 0.52249861; HC_IB[411] = 0.56694403; HC_IB[412] = 0.64682178;
  HC_IB[413] = 0.78815462; HC_IB[414] = 1.06067769; HC_IB[415] = 1.72244710; HC_IB[416] = 5.10114862;
  // position v: sections HC_IB[450 + 2v] .. HC_IB[451 + 2v]
  HC_IB[450] = 0; HC_IB[451] = 1; HC_IB[452] = 2; HC_IB[453] = 2;
  HC_IB[454] = 3; HC_IB[455] = 4; HC_IB[456] = 5; HC_IB[457] = 8;
  HC_IB[458] = 9; HC_IB[459] = 16;
);
// design one section: type 1 = LP1, 2 = LP2 (RBJ), 3 = HP2 (RBJ)
function HC_sec(sx, f, q, typ) local(w0, al, cw, nm, a0r, w, t, b)
( b = HC_IB + sx * 5;
  (typ === 1) ? (
    w = tan($pi * f / srate); t = w / (1.0 + w);
    b[0] = t; b[1] = t; b[2] = 0.0; b[3] = (1.0 - w) / (1.0 + w); b[4] = 0.0;
  ) : (
    w0 = 2.0 * $pi * f / srate; al = sin(w0) / (2.0 * q); cw = cos(w0); nm = 1.0 / (1.0 + al);
    a0r = (typ === 2) ? (1.0 - cw) * 0.5 : (1.0 + cw) * 0.5;
    b[0] = a0r * nm;
    b[1] = ((typ === 2) ? (1.0 - cw) : -(1.0 + cw)) * nm;
    b[2] = a0r * nm;
    b[3] = 2.0 * cw * nm;
    b[4] = -(1.0 - al) * nm;
  );
);
function HC_design(fcd) local(fl, fa, sx)
( hc_rn = 0;   // a direct design aborts a running ramp
  fl = min(fcd, 0.45 * srate);
  // Analog: design so that the label is at -3 dB after bilinear warping
  fa = srate / $pi * atan(tan($pi * fl / srate) / HCF_FCORR);
  sx = 0;
  loop(17,
    HC_sec(sx, (sx < 2) ? fa : fl, HC_IB[400 + sx], (sx === 0) ? 1 : 2);
    sx += 1;
  );
);
// Coefficient ramp while the frequency glides. The glide redesigns only every 8th sample
// (sm_do), and jumping to the new set left a zipper at srate/8 (5.5 kHz at 44.1, -77 dBFS
// on a -12 dBFS bass sweeping 20k -> 2k). Like the biquad ramps: the 125 coefficients move
// linearly in 8 samples from the old set (HC_IB + 800) to the new one (kept at
// HC_IB + 1050, steps at + 925).
function HC_rdesign(fcd) local(i)
( memcpy(HC_IB + 800, HC_IB, 125);
  HC_design(fcd);
  memcpy(HC_IB + 1050, HC_IB, 125);
  i = 0;
  loop(125, HC_IB[925 + i] = (HC_IB[1050 + i] - HC_IB[800 + i]) * 0.125; i += 1; );
  memcpy(HC_IB, HC_IB + 800, 125);
  hc_rn = 8;
);
function HC_rtick() local(i)
( hc_rn -= 1;
  (hc_rn > 0) ? ( i = 0; loop(125, HC_IB[i] += HC_IB[925 + i]; i += 1; ); )
              : memcpy(HC_IB, HC_IB + 1050, 125);
);
// Cascade of sections s0..s1 on x, states from st (2 per section).
function HC_run(x, st, s0, s1) local(sx, c, y)
( sx = s0;
  loop(s1 - s0 + 1,
    c = HC_IB + sx * 5;
    y = c[0] * x + st[2 * sx];
    st[2 * sx] = c[1] * x + c[3] * y + st[2 * sx + 1];
    st[2 * sx + 1] = c[2] * x + c[4] * y;
    x = y; sx += 1;
  );
  x;
);
// Tables and states (start and sample rate change).
function HC_setup()
( HC_tables();
  memset(HC_IB + 200, 0.0, 120);
);

// --- Grit / VD: even term after a bus compressor ----------------
// Calibrated on the nine colour steps of a reference bus compressor. Measured:
//
// - The device produces pure H2. H3 stays at the chain's floor over the whole control
//   range, H2 lies 31 to 40 dB above it (an odd-order tip would sound hard).
// - The harmonic content is constant over the top 12 dB of level (1.0 dB change).
// - H2 is monotonic over the control range.
//
// One number fixes the curve shape: H4 lies 14.4 dB below H2 at every step. A full-wave
// rectifier gives 14.0 dB in theory, and at low level the figure is 28 dB (quadratic).
// This curve delivers that:
//
//        g(x) = x^2 * a / (a + |x|)        small: x^2,  large: a*|x|
//        y    = x + k * g(x)
//
// Fitted to the level curve of step 5 over 36 dB: a = 0.075, mean error 0.55 dB, largest
// 1.04 dB. g is even, so it contains no fundamental and the stage is level-neutral.
//
// The device has no emphasis pair, Pade saturation with bias and feedback, expander,
// thermal low-pass, coupling RC, slew limiting or envelopes. It is memoryless (bursts
// -0.02 dB over 300 ms) and frequency-independent (three decades within 1 dB).
VD_KMAX  = 5.7482;   // Grit Amount = 100 %  -> H2 -14 dBc, just above step 9
VD_A_DEF = 0.075;    // transition quadratic -> rectifier, -22.5 dBFS

// DC component: g is positive, so it creates an offset that grows with level. On the
// device it follows level 1:1 and is damped by the coupling capacitors (110 Hz / -3 dBFS:
// -79 dB at step 1, -40 dB at step 9). Here a fixed 2 Hz high-pass does that.
VD_HP_FREQ = 2.0;

function VD_setSampleRate(ftol)
(
  ftol = MODF(ftol, K_VD);
  this.os.OS2_setSampleRate();
  this.hp.BQ_hp1(VD_HP_FREQ * ftol, srate);
);

function VD_setDrive(amount_norm, a_lin, btol)
(
  // Quadratic taper: spreads the 36 dB of usable H2 range over the control travel instead
  // of crowding it at the bottom. Its steps then sit at about 35 / 49 / 80 %.
  this.k = VD_KMAX * amount_norm * amount_norm * btol;
  this.a = max(a_lin, 0.001);
);

function VD_reset()
(
  this.os.OS2_reset();
  this.os_cold = 1;
  this.hp.BQ_clear();
  this.k = 0.0;
  this.a = VD_A_DEF;
  this.bp0 = 0.0; this.bp1 = 0.0; this.bp2 = 0.0; this.bp3 = 0.0; this.bp4 = 0.0;
);

// Grit's curve at the inner rate: x + k x^2 a / (a + |x|); even harmonics only
function VD_processOSSample(x) local(ax, d)
(
  ax = abs(x);
  d = this.k * (x * x * this.a / (this.a + ax));
  x + d;
);

function VD_processSample(x, active) local(y0, y1, y2, y3, bypass, k, v)
(
  // 5-sample FIFO (os_d: 5 / 4 / 0 by OS factor; only the cells os_d reads shift). The
  // oversampler delays by 5.000 / 4.000 base samples (polyphase halfbands completed by a
  // Thiran allpass). FIFO and PDC constant must change together.
  (os_d === 5) ? ( bypass = this.bp4; this.bp4 = this.bp3; this.bp3 = this.bp2; this.bp2 = this.bp1; this.bp1 = this.bp0; this.bp0 = x; )
  : (os_d === 4) ? ( bypass = this.bp3; this.bp3 = this.bp2; this.bp2 = this.bp1; this.bp1 = this.bp0; this.bp0 = x; )
  : bypass = x;

  // k = 0 is the far left of the control. There the stage should be bit-exact
  // transparent; the oversampler and the coupling high-pass would cost about 0.01 dB
  // together.
  //
