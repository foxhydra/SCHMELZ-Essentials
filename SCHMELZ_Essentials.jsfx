      : (cr_pm === 1) ? ( cr_gA = cr_g; cr_gB = cr_g; )
      : ( cr_g = min(cr_gA, cr_gB); cr_gA = cr_g; cr_gB = cr_g; );
      crh_dmq = crh_pq;   // the position the frozen Hardware keeps playing in
      // The Hardware restarts in the new position; what it contributed to the source becomes its frozen gain matrix.
      (cr_hwq > 0.0) ? (
