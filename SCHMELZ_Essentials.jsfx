function HPF_setSampleRate(mode, warm_mode, ftol) local(freq_hz, eff_mode)
(
  ftol = MODF(ftol, K_LC);
  eff_mode = (mode > 0) ? mode : warm_mode;
  (eff_mode < 1) ? eff_mode = 1;

  // Frequency: continuous, logarithmic, 10..300 Hz.
  freq_hz = max(10.0, min(300.0, hpf_freq));
  // The label is the -3 dB point. Designing on the label directly would put the cascade's
  // -3 dB point below it: the second stage has Q 1.2 (not Butterworth 1.0), so it falls
  // at 0.90409*fc analytically, 0.9078 measured, about 10 % too low. The design frequency
  // is raised by 1/0.90409 = 1.10608 to hit the label. The overshoot moves along and
  // stays at about +0.4 dB, now at 1.5..2x the label. Classic preamps use the same
  // convention: 50/80/160/300 are the -3 dB points, not the onset points.
  freq_hz = freq_hz * HPF_FCORR * ftol;
  this.tf = ftol;   // HPF_design takes it out again for the Butterworth slopes

  // The frequency glides to the target (HPF_glide, 15 ms in the log domain). A step during
  // playback clicked with the abrupt coefficient change. The design here still always
  // runs, with the current frequency, so the coefficients are right after a sample rate
  // change.
  this.ft = freq_hz;
  (!this.fok) ? ( this.fc = freq_hz; this.fok = 1; );
  this.HPF_design();
);

function HPF_reset()
(
  this.hp1.BQ_clear();
  this.hp2.BQ_clear();
  this.c2.BQ_clear(); this.c4a.BQ_clear(); this.c4b.BQ_clear();
  this.c8a.BQ_clear(); this.c8b.BQ_clear(); this.c8c.BQ_clear(); this.c8d.BQ_clear();
);

// Output after Low Cut Slope: the selected variant at rest, the crossfade lsw0..3 during a change.
function HPF_processSample(x) local(ya, y2, y4, y8)
(
  ya = this.hp2.BQ_tick(this.hp1.BQ_tick(x));
  y2 = this.c2.BQ_tick(x);
  y4 = this.c4b.BQ_tick(this.c4a.BQ_tick(x));
  y8 = this.c8d.BQ_tick(this.c8c.BQ_tick(this.c8b.BQ_tick(this.c8a.BQ_tick(x))));
