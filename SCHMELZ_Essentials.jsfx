// a line of width w (device pixels): a quad with anti-aliased edges and round ends; thin lines as plain lines
function ln(x1, y1, x2, y2, w) local(dx, dy, l, nx, ny)
( (w < 1.5) ? gfx_line(x1, y1, x2, y2, 1) : (
    dx = x2 - x1; dy = y2 - y1; l = sqrt(dx * dx + dy * dy);
    (l > 0.01) ? (
      nx = -dy / l * 0.5 * w; ny = dx / l * 0.5 * w;
      gfx_triangle(x1 + nx, y1 + ny, x2 + nx, y2 + ny, x2 - nx, y2 - ny, x1 - nx, y1 - ny);
      gfx_line(x1 + nx, y1 + ny, x2 + nx, y2 + ny, 1); gfx_line(x1 - nx, y1 - ny, x2 - nx, y2 - ny, 1);
