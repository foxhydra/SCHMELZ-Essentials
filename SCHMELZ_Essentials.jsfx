// --- drawing ----------------------------------------------------------------------------------------------------
function gx(v) ( ox + v * sc );
function gy(v) ( oy + v * sc );
function ink() ( gfx_r = 0.90; gfx_g = 0.94; gfx_b = 0.98; gfx_a = 1.0; );   // white ink of the print
