@gfx 900 560
// --- The interface: a blueprint ------------------------------------------------------------------------------
// The signal flow drawn as a schematic: a click on a block shows its controls as a detail
// drawing below it, a double click switches the module on / off. Plus meters, notes (note 1
// is what the hovered control does) and a title block. Everything is drawn with lines: a
// single-stroke lettering after technical lettering (stroke data generated from the font
// source), circuit symbols, scales with pointers and switch symbols. No images, no system
// font. The cyanotype ground is built once per window size (image 1), the static drawing
// once per page, size and module state (image 2 = ground + drawing); values and meters
// are drawn every frame. Logical coordinates 900 x 560 (gx / gy), scaled with the window
// (gfx_ext_retina is set in @init, so device pixels). GUI edits only set sliders and
// gfx_dirty; @block then runs SLIDER_update (filter designs stay in the audio thread).

GM = 600000;      // GUI tables below freembuf; the audio code does not touch them and @init does not clear them
SF_G = GM;        // glyph strings by character code
SF_W = GM + 128;  // glyph advance widths (tenths of the cap height)
PT = GM + 256;    // per slider n: PT[8n] min, +1 max, +2 default, +3 step, +4 log, +5 kind, +6 positions, +7 format
PGT = GM + 700;   // per page p: pgt[10p] rows, pgt[10p + 1 + i] the slider of row i
(GM[255] !== 1) ? (
