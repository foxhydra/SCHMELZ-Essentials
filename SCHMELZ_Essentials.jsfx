// The linear round trip (up + down, no curve). The dry path of a parallel mix goes through
// it so dry and wet share the oversampler's phase. With a plain delay the top octave
// cancelled (Crush Blend 50 %: -7.7 dB at 16 kHz).
function OS2_lin(x) ( this.OS2_up(x); this.OS2_down(this.os_y0, this.os_y1, this.os_y2, this.os_y3); );

HPF_FCORR = 1.10608;
// Low Cut Slope: at rest the weights are exactly 0 or 1
function LC_setWeights()
(
  lsw0 = lsv0 = (lc_sel === 0) ? 1.0 : 0.0; lsw1 = lsv1 = (lc_sel === 1) ? 1.0 : 0.0;
  lsw2 = lsv2 = (lc_sel === 2) ? 1.0 : 0.0; lsw3 = lsv3 = (lc_sel === 3) ? 1.0 : 0.0;
);

// Low Cut design: the label is the -3 dB point (HPF_FCORR, see HPF_setSampleRate).
// Q 1.2 gives a +0.5 dB console lift at ~1.67x the label (Q 1.1 measured only +0.18 dB,
// below the just noticeable difference; the documented "console resonance" did not exist).
// Besides the analog cascade (3rd order, Q 1.2), Butterworth high-passes of 2nd/4th/8th
// order run (12/24/48 dB/oct), -3 dB at the label, no overshoot. The RBJ biquads are
// prewarped at f0, so the cascade hits -3 dB at the label.
// All four variants always run (warm states); a change crossfades.
function HPF_design() local(f3)
(
  this.hp1.BQ_hp1(this.fc, srate);
  this.hp2.BQ_hp2(this.fc, 1.2, srate);
  // The channel tolerance applies only to the Analog slope (the console filter it was made
  // for). The steep Butterworth slopes stay matched like the High Cut: with the tolerance
  // on 48 dB/oct, Analog Tolerance 10 tilted the bass up to 1.8 dB L/R at 50..100 Hz.
  (this.tf < 0.5) ? this.tf = 1.0;      // not set yet (EEL2 starts at 0)
  f3 = this.fc / HPF_FCORR / this.tf;   // label (-3 dB), no tolerance
  this.c2.BQ_hp2(f3, 0.70710678, srate);
  this.c4a.BQ_hp2(f3, 0.54119610, srate); this.c4b.BQ_hp2(f3, 1.30656296, srate);
  this.c8a.BQ_hp2(f3, 0.50979558, srate); this.c8b.BQ_hp2(f3, 0.60134489, srate);
  this.c8c.BQ_hp2(f3, 0.89997622, srate); this.c8d.BQ_hp2(f3, 2.56291545, srate);
