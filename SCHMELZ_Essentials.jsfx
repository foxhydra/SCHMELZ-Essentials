    lh = CRH_HL0 * 10 ^ (-CRH_HM * (a - CRH_HG0) / 20.0); crh_t1 = CRH_HK * lh; crh_t2 = (1.0 - CRH_HK) * lh;
    p = (log10(lh) + 2.0) / 0.02;
    (p >= 108) ? crh_kh = 1.0 : ( p = max(p, 0.0); i = floor(p); crh_kh = CRH_KT[i] + (p - i) * (CRH_KT[i + 1] - CRH_KT[i]); );
  );
);
// Hard curve: C(u) = u up to t1, then t1 + t2 tanh((|u| - t1) / t2). CRH_hp is its
// antiderivative (log cosh, written to avoid overflow).
function CRH_hc(u) local(a, e)
( a = abs(u);
  (a <= crh_t1) ? u : ( e = exp(-2.0 * (a - crh_t1) / crh_t2); ((u > 0) ? 1 : -1) * (crh_t1 + crh_t2 * (1.0 - e) / (1.0 + e)); );
);
function CRH_hp(u) local(a, b)
( a = abs(u);
  (a <= crh_t1) ? 0.5 * u * u : ( b = (a - crh_t1) / crh_t2;
    0.5 * crh_t1 * crh_t1 + crh_t1 * (a - crh_t1) + crh_t2 * crh_t2 * (b - 0.6931471805599453 + log(1.0 + exp(-2.0 * b))); );
);
// The law: detector level (mean of |h|^3) -> gain reduction in dB.
function CRH_law(e, T) local(o, hw, gr)
( o = (20.0 / CRH_Q) * log10(max(e, 0.000000000000000000000000000001)) + CRH_CQ - T; hw = 0.5 * CRH_W;
  gr = (o <= -hw) ? 0.0 : (o < hw) ? -CRH_S1 * (o + hw) * (o + hw) / (2.0 * CRH_W)
     : (o < CRH_O2) ? -CRH_S1 * o : -CRH_S1 * CRH_O2 - CRH_S2 * (o - CRH_O2);
  max(gr, -CRH_RNG);
);
// Its inverse: the detector state for a given gain (a position change restarts at the current gain).
function CRH_inv(gr, T) local(o, hw)
( hw = 0.5 * CRH_W;
  o = (gr >= 0.0) ? -hw - 1.0 : (-gr <= CRH_S1 * CRH_W * 0.5) ? sqrt(-gr * 2.0 * CRH_W / CRH_S1) - hw
    : (-gr <= CRH_S1 * CRH_O2) ? -gr / CRH_S1 : CRH_O2 + (-gr - CRH_S1 * CRH_O2) / CRH_S2;
  10 ^ ((o + T - CRH_CQ) * CRH_Q / 20.0);
);
// One branch: input stage + element (instances crhA / crhB). g is the branch's gain, noel = no gain reduction.
function CRH_el(x, g, noel) local(s, ds, rc, v, A, u, du, r, uc)
( s = x * crh_gi;
  (!this.ok) ? this.s1p = s;
  ds = s - this.s1p;
  rc = (abs(ds) > 0.000000001) ? (CRH_cprim(s) - CRH_cprim(this.s1p)) / ds : CRH_cf(0.5 * (s + this.s1p));
  this.s1p = s; s += rc;
  v = s * g; this.v = v;
  // At a (re)start the RMS follower holds the peak while the oversampler fills (starting from 0, u would be huge and click)
  (this.wu > 0) ? ( this.ms = max(this.ms, v * v); this.wu -= 1; );
  this.ms += crh_kq * (v * v - this.ms);
  A = max(sqrt(2.0 * this.ms), 0.000000001); u = v / A;
  (!this.ok) ? this.u1 = u;
  du = u - this.u1;
  r = (abs(du) > 0.000001) ? (CRH_rprim(u, crh_lim, crh_kap) - CRH_rprim(this.u1, crh_lim, crh_kap)) / du
                            : CRH_rf(0.5 * (u + this.u1), crh_lim, crh_kap);
  // hard regime: residual of C / kh - u, same ADAA as above
  crh_hd ? ( r += crh_hw * ((abs(du) > 0.000001) ? ((CRH_hp(u) - CRH_hp(this.u1)) / crh_kh - 0.5 * (u * u - this.u1 * this.u1)) / du
                                                 : CRH_hc(0.5 * (u + this.u1)) / crh_kh - 0.5 * (u + this.u1)); );
  this.u1 = u; this.ok = 1;
  uc = min(max(u, -1.5), 1.5);
  noel ? v : v + A * r + crh_c2 * A * (2.0 * uc * uc - 1.0);
);
// One branch at the inner rate (OS2 like Grit / Tone): input stage + element per inner
// sample, gain g held over the base sample. The detector hears the last inner v (feedback).
function CRH_br(x, g, noel) local(k, y, y0, y1, y2, y3)
( this.os.OS2_up(x);
  k = 0;
  loop(os_f,
    y = this.CRH_el((k === 0) ? this.os.os_y0 : (k === 1) ? this.os.os_y1 : (k === 2) ? this.os.os_y2 : this.os.os_y3, g, noel);
    (k === 0) ? y0 = y : (k === 1) ? y1 = y : (k === 2) ? y2 = y : y3 = y;
    k += 1;
  );
  this.os.OS2_down(y0, y1, y2, y3);
);
// Detector input of a branch: 1st-order HP of v, then |h|^3.
function CRH_det() local(h)
( h = crh_c * (this.hy + this.v - this.hx); this.hx = this.v; this.hy = h; abs(h) * h * h; );
// Restart both branches at the gains gA / gB (switch-on, position change).
function CRH_reset(gA, gB, T)
( crhA.hx = crhA.hy = crhA.ms = crhA.ok = 0; crhB.hx = crhB.hy = crhB.ms = crhB.ok = 0;
  crhA.os.OS2_reset(); crhB.os.OS2_reset(); crhA.wu = crhB.wu = 32 * os_f;
  crh_grA = min(20.0 * log10(max(gA, 0.00001)), 0.0); crh_grB = min(20.0 * log10(max(gB, 0.00001)), 0.0);
  crh_gA = 10 ^ (crh_grA / 20.0); crh_gB = 10 ^ (crh_grB / 20.0);
  crh_eA = (crh_grA < 0.0) ? CRH_inv(crh_grA, T) : 0.0; crh_eB = (crh_grB < 0.0) ? CRH_inv(crh_grB, T) : 0.0;
);
// Fixed make-up (linear) for Sensitivity - Drive (table from -50 dB in 1-dB steps).
function CRH_mk(xs) local(q, i)
( q = min(max(xs - CRH_MX0, 0.0), 61.999); i = floor(q);
  10 ^ ((CRH_M[i] + (q - i) * (CRH_M[i + 1] - CRH_M[i])) / 20.0);
);

function CR_setSampleRate()
(
  cr_pst = 100.0 / srate;   // 10 ms
);

function CR_reset()
(
  cr_g = 1.0; cr_gA = 1.0; cr_gB = 1.0; cr_pa = 0.0;
  // Start in the set position, otherwise the first sample would see a change and the
  // crossfade would run from g = 1.
  cr_pm = (slider20 >= 0.5) ? (slider20 | 0) + 1 : 1;
  cr_fx = 0.0; cr_f1 = 0.0;
  cr_hwq = 0; CRH_reset(1.0, 1.0, 0.0);
  crdL.OS2_reset(); crdR.OS2_reset();   // the dry round trip (Blend)
);


function SI_setShuffle(freq_hz, space_dB) local(clamped_hz, sS)
(
  // Gain-dependent slope and boost corner walk (same fix as the Tone shelves). A fixed
  // S=0.50 gave only half the dialled dB at the shuffle frequency and smeared large Depth
  // settings.
  clamped_hz = freq_hz;
  (space_dB > 0) ? clamped_hz = clamped_hz * (1.0 + 0.25 * space_dB / 12.0);
  (clamped_hz > srate * 0.49) ? clamped_hz = srate * 0.49;
  sS = 0.50 + (abs(space_dB) / 12.0) * 0.40;
  (sS > 0.90) ? sS = 0.90;
  this.side_shelf.BQ_lowShelf2_S(clamped_hz, DB_TO_K(space_dB), sS, srate);
);

// --- Mono Maker (MM) ------------------------------------------
// True mono below a selectable corner: LR4 crossover on M/S. The side goes through the
// LR4 high-pass (two 2nd-order Butterworths), the mid through the allpass that the LR4
// low- and high-pass sum to. Above the corner mid and side have the same phase, so the
// panorama stays. (A high-pass on the side alone rotates its phase against the mid far
// above its corner, and a tone playing only left came out louder on the right.) The
// price, as with every crossover mono maker: the mono sum is allpass-filtered (same
// level, phase-rotated in the bass around the corner).
// The corner is the crossover point (-6 dB on the side).
//
// Why steep: a shelf (Field Depth can already do that) ends at a finite value, while
// true mono means minus infinity, and only a high-pass gets there. 4th order gives -24 dB
// one octave below the corner and -48 dB two octaves below, which is audibly mono. 2nd
// order is only at -12 dB there.
//
// No channel tolerance and no Spread scaling: the stage should work exactly, not scatter
// like analogue.
// glide > 0 only sets the target; the frequency glides in @sample (log, 40 ms in mm_gk,
// since 15 ms still gave +3 dB at 50 -> 400 Hz; design every 8th sample with an 8-sample
// ramp, as in the Low Cut). A 20 ms coefficient ramp alone still clicked at 50 -> 400 Hz
// with +12 dB above 300 Hz. glide = 0 sets it immediately (init, sample rate).
// Off (mode 0) first glides down to 2 Hz (MM_LO, MM_setSampleRate), so the fade-out runs there.
function MM_design(ramp)
(
  (ramp > 0) ? ( this.s1.BQ_hold(); this.s2.BQ_hold(); this.ap.BQ_hold(); );
  this.s1.BQ_hp2(this.fc, 0.7071068, srate);
  this.s2.BQ_hp2(this.fc, 0.7071068, srate);
  this.ap.BQ_ap2(this.fc, 0.7071068, srate);
  (ramp > 0) ? ( this.s1.BQ_rampStart(ramp); this.s2.BQ_rampStart(ramp); this.ap.BQ_rampStart(ramp); );
);

// Switching on and off goes through a 2-Hz corner. The crossfade between the dry mid and
// its allpassed version cancelled at the corner (a mono 100-Hz tone dipped up to -28 dB
// for ~15 ms), and at 2 Hz the allpass is nearly neutral in the audible band. On: fade in
// at 2 Hz and glide up. Off: glide down, then fade out.
MM_LO = 2.0;
// Bass Mono: the corner from the switch position (off glides down to MM_LO first). glide = 0 sets it at once.
function MM_setSampleRate(mode, glide) local(f)
(
  (mode >= 1) ? (
  (mode ==  1) ? f =  50.0 :
  (mode ==  2) ? f =  60.0 :
  (mode ==  3) ? f =  70.0 :
  (mode ==  4) ? f =  80.0 :
  (mode ==  5) ? f = 100.0 :
  (mode ==  6) ? f = 120.0 :
  (mode ==  7) ? f = 150.0 :
  (mode ==  8) ? f = 180.0 :
  (mode ==  9) ? f = 220.0 :
  (mode == 10) ? f = 250.0 :
  (mode == 11) ? f = 315.0 :
                 f = 400.0;
  ) : (
    f = MM_LO;   // off glides down to 2 Hz first
  );
  this.ft = f;
  this.f  = f;                         // for the gfx status line
  (glide <= 0 || this.fc <= 0.0) ? ( this.fc = f; this.fg = f; this.MM_design(0); );
);

function MM_glide(k, redesign)
( // two stages (in log frequency). A one-stage glide started at full speed, and sweeping
  // the allpass fast past a bass tone bumped its level by up to +4.4 dB when Bass Mono
  // went off through the 2-Hz corner.
  (this.fg <= 0.0) ? this.fg = this.fc;
  this.fg = exp(log(this.ft) + k * (log(this.fg) - log(this.ft)));
  this.fc = exp(log(this.fg) + k * (log(this.fc) - log(this.fg)));
  (abs(this.fc / this.ft - 1.0) < 0.0005 && abs(this.fg / this.ft - 1.0) < 0.0005) ? ( this.fc = this.ft; this.fg = this.ft; redesign = 1; );
  redesign ? this.MM_design(8);
);

function MM_reset()
(
  this.s1.BQ_clear();
  this.s2.BQ_clear();
  this.ap.BQ_clear();
);

// High Width: a high shelf on the side signal, with the same Shuffle corner as the Depth
// shelf. Depth acts below, High Width above: together a tilt around a pivot.
//
// Model: a reference width processor. Its mid is untouched at every setting (0.00 dB and
// 0.00 degrees) and the side gets a high shelf whose gain is the control (up to +15 dB).
// Its maker says it is not M/S processing; measured, it is exactly that. There a Range
// control moves the corner and a Stage control the slope; here the Shuffle control and
// the level-dependent slope do that. Only on S, never on M, so the mono sum is untouched.
function SI_setBigness(freq_hz, gain_dB) local(sS)
(
  // Same rule as for the Depth shelf: the slope grows with the level, otherwise a fixed
  // S never delivers the set value. The reference stays 12 although the control only
  // goes to 6 dB.
  sS = 0.50 + (gain_dB / 12.0) * 0.40;
  (sS > 0.90) ? sS = 0.90;
  this.big_shelf.BQ_highShelf2_S(freq_hz, DB_TO_K(gain_dB), sS, srate);
);

function SI_reset()
(
  this.side_shelf.BQ_clear();
  this.big_shelf.BQ_clear();
);

// --- Iron / TX: transformer as a flux model -------------------
// Calibrated on the transformer of a reference hardware unit. A transformer has no band;
// it has a core, and its flux is the time integral of the voltage. That is why it
// saturates at the bottom: same voltage, half the frequency, double the flux. Model the
// flux and the frequency dependence follows. A band model (lowpass -> biased curve ->
// envelope) would not give that.
//
//   emphasis (+24 dB low) -> curve -> exact inverse -> HF shelf
//
// (applied as an error term added to the unchanged signal through a 600 Hz lowpass, see
// TX_RES_LP)
//
// - Below the knee the chain is mathematically the identity (the inverse is computed
//   prewarp-exact). Measured: at low level the device does -0.03 dB at 20 Hz, i.e. nothing.
// - The bass loss at full level (-5.04 dB at 20 Hz) comes by itself, because the energy
//   moves into the harmonics. No level-controlled highpass needed.
// - No envelope. The device drifts by 0.001 dB after a loud step. An envelope modulating
//   highpass and shelf in the bass rhythm gave two-tone 41 Hz + 5 kHz sidebands of
//   -53.5 dBc vs. -79...-85 on the model.
// - The HF shelf is fixed. Measured +0.99 dB at 10 kHz, identical hot and quiet.
//
// The operating point is not taken from the device: it does nothing at -9 dBFS and
// everything at -3 (42 dB H3 jump within 6 dB). That wall is physically real but useless
// as a fixed setting, so it sits on Iron Drive.
// The character is blendable: the device is odd-dominant (H3 30 dB above H2). Iron
// Character moves from the measured curve (0 %) to even warmth (100 %). A biased core is
// a real component.

TX_EMPH_HZ   = 15.0;      // pole of the flux emphasis, 1st order
TX_EMPH_DB   = 24.0;      // 6 dB/oct from 15 Hz to about 240 Hz (= zero)
// The pole must sit below the useful band: it marks where the 6 dB/oct slope starts, and
// below it the emphasis is flat. With 80 Hz, 30 and 80 Hz got almost the same flux
// (2.4 dB measured instead of the 8.5 dB the flux law demands) and the frequency
// selectivity was practically zero (H3 at 30 and 80 Hz within 0.4 dB). With 15 Hz it is
// 7.3 dB, and the H3 span 30 vs. 80 Hz is 42 dB (device: 56).
// At low level the device leaves 0.03 dB at 20 Hz, which corresponds to a corner of about
// 1.7 Hz. A transformer cannot pass DC and the asymmetric curve creates some, so the
// highpass stays, fixed and very low instead of level-controlled.
TX_HP_FREQ   = 2.0;
TX_HF_FREQ   = 10000.0;
TX_HF_S      = 0.70;
// 2.14 dB is the asymptote of the S shelf, not its value at the corner; at S 0.70 the
// shelf gives about half at the corner. Back-calculated from the measurement (+0.27 at
// 5k, +0.99 at 10k, +1.71 at 16k) the shape fits to 0.08 dB. It is fixed: the device
// shows the same value hot and quiet.
TX_HF_GAIN   = 2.14;
TX_DRIVE_MIN = 0.5;       // Iron Drive = 0, practically linear
TX_DRIVE_MAX = 12.0;      // Iron Drive = 10, deep in saturation
TX_BIAS_MAX  = 0.45;      // Iron Character = 100 %
// The error term (curve minus flux, de-emphasised back) goes through a 4th-order
// Butterworth lowpass before it is added to the signal. The alternative, D(c(E x)), clips
// the flux and differentiates back. That lets the treble through the curve too, its gain
// modulated by the bass, and the inverse restores carrier and sidebands alike. Measured
// with 41 Hz (-6 dBFS) + 5 kHz at Drive 3: sidebands -29 dBc; at Drive 7 the 5 kHz tone
// was nearly destroyed (+-82 Hz -5 dBc). The device: -79..-85.
// In a transformer the voltage appears linearly at the output. The saturated core only
// draws magnetising current, and its drop across the source impedance adds. That depends
// on the flux, in which 5 kHz sits 50 dB below the bass. So y = x + LP(D(c(Phi) - Phi)).
// The curve still sees the full flux (no band model); only the error is not fed back into
// the treble. Bass harmonics at 30/50/80 Hz and the hot bass loss stay within 0.2 dB of
// the signal-path form, imd -29 -> -104 dBc.
TX_RES_LP    = 600.0;

// Curve: v / (1 + v^8)^(1/8). Smooth, bounded to 1, slope 1 at zero. The eighth power
// gives about 48 dB harmonic rise per 6 dB of level; the device shows 42 dB in the first
// step. The fourth power was too soft: it saturated a little at medium levels, and the
// two-tone 41 Hz + 5 kHz gave -30 dBc sidebands, worse than a band model's -53.5, which
// is the flaw this model was meant to fix. A transformer is very clean below its knee,
// and the sharpness of the curve is what prevents intermodulation.
// Rejected: a piecewise curve (linear up to 0.8, then an arc). It was exactly linear
// below the knee and produced no harmonics there; measured, Iron jumped from -13.6 dBc
// straight to nothing when the level dropped 6 dB. The model has a tail there
// (-49.9 / -67.6 / -73.4), and a module that switches on abruptly is a switch, not a tone
// colour. The knee hardness of the piecewise variant also had no effect (0.80 to 0.97
// measured identical); at the required drive the stage sits deep in limiting anyway.
// Three sqrt instead of pow: (1+v^8)^(1/8) = sqrt(sqrt(sqrt(1+v^8))).
function TX_curve(v) local(v2, v4)
(
  v2 = v * v;  v4 = v2 * v2;
  v / sqrt(sqrt(sqrt(1.0 + v4 * v4)));
);

function TX_setSampleRate(ftol) local(g, f1, f2, hf_hz)
(
  ftol = MODF(ftol, K_TX);
  g  = DB_TO_K(TX_EMPH_DB);
  f1 = TX_EMPH_HZ * ftol;
  // Exact inverse of a 1st-order low shelf: the pole moves by the factor g, prewarp-exact.
  // Otherwise a residue remains and spoils transparency below the knee.
  f2 = atan(tan($pi * f1 / srate) * g) * srate / $pi;
  (f2 > srate * 0.45) ? f2 = srate * 0.45;
  this.emph_pre.BQ_lowShelf1(f1, g, srate);
  this.emph_post.BQ_lowShelf1(f2, 1.0 / g, srate);
  this.emph_ig = 1.0 / g;        // normalise the pre-stage to unity at DC
  this.emph_og = g;
  this.hp.BQ_hp1(TX_HP_FREQ * ftol, srate);
  hf_hz = min(TX_HF_FREQ * ftol, srate * 0.49);
  this.hf_shelf.BQ_highShelf2_S_matched(hf_hz, DB_TO_K(TX_HF_GAIN), TX_HF_S, srate);
  this.res_lp1.BQ_lp2(TX_RES_LP, 0.5411961, srate);   // 4th-order Butterworth
  this.res_lp2.BQ_lp2(TX_RES_LP, 1.3065630, srate);
);

// Iron: the core drive comes from Drive, the bias (even warmth) from Character, with the channel tolerance.
function TX_setDrive(drv, bias_n, btol) local(b)
(
  this.drive = drv;
  b = bias_n * TX_BIAS_MAX * btol;
  (b >  0.7) ? b =  0.7;         // stay below the knee, or the
  (b < -0.7) ? b = -0.7;         // small-signal normalisation breaks
  this.bias = b;
  this.dc   = TX_curve(b);
  // Below the knee 1/(drive * slope) cancels the drive again, so the stage is transparent
  // there. The slope at the operating point is c'(b) = (1 + b^8)^(-9/8). With a bias
  // (Character) it is below 1, and 1/drive left (c'(b) - 1) * flux in the error term: a
  // bass shelf under 600 Hz, -0.12 dB on the left at Character 100 / Analog Tolerance 10
  // and -0.00 on the right (L/R bass imbalance).
  this.comp = 1.0 / max(drv * ((1.0 + (b * b) * (b * b) * (b * b) * (b * b)) ^ (-1.125)), 0.000001);
);

function TX_reset()
(
  (this.btol < 0.0001) ? this.btol = 1.0;
  // Defaults in case a sample runs before the first @slider; without them comp = 1/0
  // and the stage blows up.
  this.drive = 1.0;  this.bias = 0.0;  this.dc = 0.0;  this.comp = 1.0;
  this.emph_pre.BQ_clear();
  this.emph_post.BQ_clear();
  this.hp.BQ_clear();
  this.hf_shelf.BQ_clear();
  this.res_lp1.BQ_clear();
  this.res_lp2.BQ_clear();
);

function TX_processSample(x) local(f, v, y)
(
  f = this.emph_pre.BQ_tick(x) * this.emph_ig;      // core flux
  v = f * this.drive + this.bias;
  // error term: what the curve takes away from the flux (see above)
  y = (TX_curve(v) - this.dc) * this.comp - f;
  y = this.emph_post.BQ_tick(y) * this.emph_og;
  y = this.res_lp2.BQ_tick(this.res_lp1.BQ_tick(y));
  y = this.hp.BQ_tick(x + y);
  this.hf_shelf.BQ_tick(y);
);

// --- Crosstalk: capacitive coupling, rises 6 dB/oct ---
// ~ -82 dB @ 1 kHz, -65 dB @ 10 kHz (console adjacent-channel spec)
XT_AMOUNT = 0.0008;
XT_HP_FREQ = 10000.0;
// Asymmetry. Symmetric crosstalk cannot widen a stereo image: on mono material it lands
// entirely in the mid, and where L and R differ it blends them into each other, so it
// narrows. Measured, the contribution to the side signal was zero, even at ten times the
// level. In real hardware crosstalk depends on the layout and differs between the two
// directions, so L->R and R->L get different strength and a different coupling corner.

function XT_setSampleRate()
(
  this.hp.BQ_hp1(min(XT_HP_FREQ * this.ftol, srate * 0.45), srate);
);

function XT_reset()
(
  (this.amt  < 0.0001) ? this.amt  = 1.0;
  (this.ftol < 0.0001) ? this.ftol = 1.0;
  this.hp.BQ_clear();
);

function XT_process(x) local(y)
(
  y = this.hp.BQ_tick(x) * XT_AMOUNT * this.amt;
  y;
);

// Per channel: the channel's filters (Low Cut, Grit, Tone, Field shelves, Iron) with its tolerance ftol.
function CH_setSampleRate(hpf_mode, hpf_warm, ve_low_i, ve_low_g, ve_hi_i, ve_hi_g,
                          si_freq, si_space, ftol)
(
  this.hpf.HPF_setSampleRate(hpf_mode, hpf_warm, ftol);
  this.vd.VD_setSampleRate(ftol);
  !ch_skve ? this.ve.VE_setSampleRate(ve_low_i, ve_low_g, ve_hi_i, ve_hi_g, ftol);   // not while Tone glides / ramps
  // Crush does not need the crossover filters, but the same time constants.
  !ch_sksi ? this.si.SI_setShuffle(si_freq, si_space);   // not while the Field shelves glide / ramp
  this.tx.TX_setSampleRate(ftol);
);

function CH_reset()
(
  this.hpf.HPF_reset();
  this.vd.VD_reset();
  this.ve.VE_reset();
  this.si.SI_reset();
  this.tx.TX_reset();
);

OS_setFactor();   // before everything that needs the inner rate

// Compensation of the FIR edge at 44.1 kHz: RBJ bell at the 2x rate.
clf_eq = (srate > 43000 && srate < 46000) ? 1 : 0;
ceq_A = 10 ^ (1.254 / 40.0); ceq_w = 2.0 * $pi * 20014.7 / (2.0 * srate); ceq_al = sin(ceq_w) / (2.0 * 16.1768);
ceq_n = 1.0 / (1.0 + ceq_al / ceq_A);
ceq_b0 = (1.0 + ceq_al * ceq_A) * ceq_n; ceq_b1 = -2.0 * cos(ceq_w) * ceq_n; ceq_b2 = (1.0 - ceq_al * ceq_A) * ceq_n;
ceq_a1 = ceq_b1; ceq_a2 = (1.0 - ceq_al / ceq_A) * ceq_n;
left.CH_reset();
right.CH_reset();
left.tx.btol  = TX_BTOL_L;
right.tx.btol = TX_BTOL_R;
SPREAD_apply(slider33);

// output coupling caps: 1st-order HP, both 5 Hz
out_hp_L.BQ_hp1(5.0, srate);
out_hp_R.BQ_hp1(5.0, srate);
out_hp_L.BQ_clear();
out_hp_R.BQ_clear();

xt_L.XT_reset();
xt_R.XT_reset();
xt_L.amt  = XT_ATOL_L;  xt_L.ftol = XT_FTOL_L;
xt_R.amt  = XT_ATOL_R;  xt_R.ftol = XT_FTOL_R;

wt_L.WT_reset(); wt_R.WT_reset();
// DC highpass 5 Hz before the clip curve, one pole: base rate for the dry side of Blend,
// inner rate for the wet path (in CLF_curve)
cl_hk1 = 1.0 - exp(-2.0 * $pi * 5.0 / srate);
cl_hko = 1.0 - exp(-2.0 * $pi * 5.0 / (os_f * srate));
// Weight Mode: starts on the switch
wm_t = (slider38 >= 0.5) ? 1.0 : 0.0;
wm_x1 = wm_t; wm_m = wm_t; wm_s = 1.0;
// Clip Sub Cut: starts on the switch (REAPER zeroes everything in @init)
csb_on = (slider42 >= 10.0) ? 1.0 : 0.0;
csb_ft = CSB_freq(slider42);
csb_fc = csb_ft;
csb_x1 = csb_on; csb_xm = csb_on;
CSB_setCoef();

// heap: the two clipper channels from 0 (176 cells each, CLF_init)
clf_L.CLF_init(0);
clf_R.CLF_init(clf_L.mem_end);
// Crush IN crossfade, starts on the switch
cr_x1 = (slider19 >= 0.5) ? 1.0 : 0.0;
cr_xm = cr_x1;
// Tone and Field also start on the switch. REAPER sets all variables to 0 in @init (load,
// every playback start); otherwise both would fade in from the dry signal for ~20 ms
// after every start.
left.ve.i1  = (slider11 >= 0.5) ? 1.0 : 0.0;  left.ve.im  = left.ve.i1;
right.ve.i1 = left.ve.i1;                    right.ve.im = left.ve.i1;
si_x1 = (slider25 >= 0.5) ? 1.0 : 0.0;
si_xm = si_x1;
si_nn = floor(0.05 * srate); si_nc = si_nn;   // at a start the shelves are empty = settled
CR_setSampleRate(); CRH_setSampleRate(); crhA.os.OS2_setSampleRate(); crhB.os.OS2_setSampleRate();
CR_reset();
cr_last = (slider20 | 0) + 1;   // position from Crush Mode (a slider of its own, survives every start)
hc_mtop = clf_R.mem_end;
HC_setup();
freembuf(max(hc_mtop, HC_IB + 5624));
os_warm_n = floor(0.010 * srate);   // lead-in when switching on
mm_gk = exp(-1.0 / (0.040 * srate));   // Mono Maker: frequency glides 40 ms
tx_warm_n = floor(0.040 * srate);   // Iron: build up the core flux
// Iron blend starts on the switch (the filters were just cleared in CH_reset, and the
// stage runs from the first sample)
tx_x1 = (slider30 >= 0.5) ? 1.0 : 0.0;
tx_xm = tx_x1;
tx_off = 0;
tx_warm = 0;
mono_mode = slider34 | 0;
mm.f = 0.0; mm.ft = 0.0; mm.fc = 0.0;
mm.MM_reset();
mm.MM_setSampleRate(mono_mode, 0);
mm_prev = mono_mode;
// Mono Maker crossfade, starts on the switch
mm_x1 = (mono_mode > 0) ? 1.0 : 0.0;
mm_xm = mm_x1;

left.si.SI_setBigness(cur_shuf, cur_big);

last_srate = 0.0;

hpf_freq      = slider3;   // Low Cut continuous; hpf_mode only 0/1
hpf_last_on   = 1;

out_peak_L = 0.0; out_peak_R = 0.0;
hfc_gr_db  = 0.0;
crush_gr_db = 0.0;
// The GUI's own state (mouse edge) is not reset here. A restart (seek, play start) would
// leave the GUI mid-gesture and a held mouse button would read as a new click. REAPER
// clears it on load.

mod_act_cl = 0.0;

function OS_fifo(x) local(y)   // a path delayed like the oversampler (os_d samples)
( (os_d === 5) ? ( y = this.bp4; this.bp4 = this.bp3; this.bp3 = this.bp2; this.bp2 = this.bp1; this.bp1 = this.bp0; this.bp0 = x; )
  : (os_d === 4) ? ( y = this.bp3; this.bp3 = this.bp2; this.bp2 = this.bp1; this.bp1 = this.bp0; this.bp0 = x; )
  : y = x;
  y;
);
ve_di = (srate > 100000) ? 32 : (srate > 50000) ? 16 : 8;   // Tone redesign interval: 8 / 16 / 32 samples by rate
sm_init = 0;
hot_start = 1;   // the first sample after @init starts Grit and the Tone colour fully

// prev_slider* must track the current slider values, not the defaults. @init runs again on
// load, srate change, transport start and DAW un-bypass, and a non-default slider would
// fire auto-activation every time.
prev_slider2 = slider2; prev_slider3 = slider3; prev_slider4 = slider4; prev_slider5 = slider5;
prev_slider6 = slider6; prev_slider7 = slider7; prev_slider8 = slider8; prev_slider9 = slider9;
prev_slider10 = slider10; prev_slider11 = slider11; prev_slider13 = slider13; prev_slider14 = slider14;
prev_slider15 = slider15; prev_slider16 = slider16; prev_slider18 = slider18; prev_slider19 = slider19;
prev_slider20 = slider20; prev_slider21 = slider21; prev_slider23 = slider23; prev_slider24 = slider24;
prev_slider22 = slider22; prev_slider25 = slider25; prev_slider26 = slider26; prev_slider27 = slider27;
prev_slider28 = slider28; prev_slider29 = slider29; prev_slider30 = slider30; prev_slider31 = slider31;
prev_slider32 = slider32; prev_slider35 = slider35; prev_slider36 = slider36; prev_slider37 = slider37;
prev_slider38 = slider38; prev_slider39 = slider39; prev_slider40 = slider40; prev_slider41 = slider41;
prev_slider42 = slider42;

// The body of @slider as a function. The GUI changes sliders in the gfx thread and sets
// gfx_dirty; @block then calls this (filter designs stay in the audio thread).
function SLIDER_update()
(
// Auto-activation reacts only to a single control move. A preset recall or undo changes
// many sliders in one @slider call and must not switch modules on (a preset with Grit off
// would load with Grit on). A module whose own IN changed in the same call is left as set.
aa_n = (slider3 != prev_slider3) + (slider4 != prev_slider4) +
        (slider6 != prev_slider6) + (slider7 != prev_slider7) +
        (slider9 != prev_slider9) + (slider10 != prev_slider10) +
        (slider13 != prev_slider13) + (slider14 != prev_slider14) + (slider15 != prev_slider15) +
        (slider16 != prev_slider16) + (slider18 != prev_slider18) +
        (slider20 != prev_slider20) + (slider21 != prev_slider21) + (slider23 != prev_slider23) +
        (slider24 != prev_slider24) + (slider22 != prev_slider22) +
        (slider26 != prev_slider26) + (slider27 != prev_slider27) + (slider28 != prev_slider28) +
        (slider29 != prev_slider29) +
        (slider31 != prev_slider31) + (slider32 != prev_slider32) +
        (slider35 != prev_slider35) + (slider37 != prev_slider37) + (slider38 != prev_slider38) +
        (slider39 != prev_slider39) + (slider40 != prev_slider40) + (slider41 != prev_slider41) +
        (slider42 != prev_slider42) +
        (slider2 != prev_slider2) + (slider5 != prev_slider5) + (slider8 != prev_slider8) +
        (slider11 != prev_slider11) + (slider19 != prev_slider19) + (slider25 != prev_slider25) +
        (slider30 != prev_slider30) + (slider36 != prev_slider36);
aa_ok = (aa_n <= 2) ? 1 : 0;

// moving a module's control switches the module on
(aa_ok && slider2 < 0.5 && slider2 == prev_slider2 && (slider3 != prev_slider3 || slider4 != prev_slider4)) ? (
  slider2 = 1; slider_automate(slider2);
);
(aa_ok && slider5 < 0.5 && slider5 == prev_slider5 && (slider6 != prev_slider6 || slider7 != prev_slider7)) ? (
  slider5 = 1; slider_automate(slider5);
);
(aa_ok && slider8 < 0.5 && slider8 == prev_slider8 && (slider9 != prev_slider9 || slider10 != prev_slider10)) ? (
  slider8 = 1; slider_automate(slider8);
);
(aa_ok && slider11 < 0.5 && slider11 == prev_slider11 && (slider13 != prev_slider13 || slider14 != prev_slider14 || slider15 != prev_slider15 ||
               slider16 != prev_slider16 || slider18 != prev_slider18)) ? (
  slider11 = 1; slider_automate(slider11);
);
(aa_ok && slider19 < 0.5 && slider19 == prev_slider19 && (slider20 != prev_slider20 || slider21 != prev_slider21 || slider23 != prev_slider23 || slider24 != prev_slider24
    || slider22 != prev_slider22)) ? (
  slider19 = 1; slider_automate(slider19);   // the position is kept in Crush Mode
);
(aa_ok && slider25 < 0.5 && slider25 == prev_slider25 && (slider26 != prev_slider26 || slider27 != prev_slider27 ||
               slider28 != prev_slider28 || slider29 != prev_slider29)) ? (
  slider25 = 1; slider_automate(slider25);
);
(aa_ok && slider30 < 0.5 && slider30 == prev_slider30 && (slider31 != prev_slider31 || slider32 != prev_slider32)) ? (
  slider30 = 1; slider_automate(slider30);
);
(aa_ok && slider36 < 0.5 && slider36 == prev_slider36 && (slider39 != prev_slider39 || slider40 != prev_slider40 ||
               slider41 != prev_slider41 || slider37 != prev_slider37 ||
               slider42 != prev_slider42 || slider38 != prev_slider38 ||
               slider35 != prev_slider35)) ? (
  slider36 = 1; slider_automate(slider36);
