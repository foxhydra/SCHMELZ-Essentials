    // Directly after @init (hot_start): no warm-up, fully on. At start the dry path is
    // empty too, and a warm-up would delay Grit after every playback start.
    this.os_cold ? ( this.os.OS2_reset(); this.os_cold = 0;
                     hot_start ? ( this.os_warm = 0; this.x1 = this.xt; this.xm = this.xt; )
                               : ( this.os_warm = os_warm_n; this.x1 = 0.0; this.xm = 0.0; ); );
    this.os.OS2_up(x);
