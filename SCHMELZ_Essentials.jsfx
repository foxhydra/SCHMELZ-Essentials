  // stage 1 at base rate: path 0 gives the even 2x sample, path 1 the odd one (interpolation gain 2 included)
  a0 = this.ua3.OS_ap(this.ua2.OS_ap(this.ua1.OS_ap(this.ua0.OS_ap(x, OS_H1_0), OS_H1_2), OS_H1_4), OS_H1_6);
  a1 = this.ub3.OS_ap(this.ub2.OS_ap(this.ub1.OS_ap(this.ub0.OS_ap(x, OS_H1_1), OS_H1_3), OS_H1_5), OS_H1_7);
